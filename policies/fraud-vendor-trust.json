{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FraudlyticsWithExternalIdOnly",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::VENDOR_ACCOUNT_ID:root" },
      "Action": "sts:AssumeRole",
      "Condition": { "StringEquals": { "sts:ExternalId": "EXTERNAL_ID_FROM_VENDOR" } }
    }
  ]
}
