{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTransactionsPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nkosi-txn-data-OWNER_ACCOUNT_ID",
      "Condition": { "StringLike": { "s3:prefix": ["transactions/*"] } }
    },
    {
      "Sid": "ReadTransactionsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::nkosi-txn-data-OWNER_ACCOUNT_ID/transactions/*"
    }
  ]
}
